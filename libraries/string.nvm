// ============================================================================
// string.nvm — Novium Standard Library: String Utilities
// ============================================================================
//
// Provides basic string manipulation functions.
//
// Usage:
//   use "string.nvm"
//
// Examples:
//
//   let greeting: string = "Hello"
//   let upper: string = to_upper(greeting)
//   let parts: int[] = split("a,b,c", ',')
//
// ============================================================================

// ── String Length ─────────────────────────────────────────────────────────

// Returns the number of characters in a string
fn str_len(s: string) -> int:
    var count: int = 0
    var i: int = 0
    while i < s.size():
        count = count + 1
        i = i + 1
    return count

// ── String Concatenation ──────────────────────────────────────────────────

// Concatenates two strings
fn str_concat(a: string, b: string) -> string:
    var result: string = ""
    var i: int = 0
    while i < a.size():
        result = result + a[i]
        i = i + 1
    var j: int = 0
    while j < b.size():
        result = result + b[j]
        j = j + 1
    return result

// ── String Search ─────────────────────────────────────────────────────────

// Checks if a string contains a substring
fn str_contains(haystack: string, needle: string) -> bool:
    var i: int = 0
    while i <= haystack.size() - needle.size():
        var j: int = 0
        var match: bool = true
        while j < needle.size():
            if haystack[i + j] != needle[j]:
                match = false
                break
            j = j + 1
        if match:
            return true
        i = i + 1
    return false

// ── String Manipulation ───────────────────────────────────────────────────

// Converts a string to uppercase (ASCII only)
fn to_upper(s: string) -> string:
    var result: string = ""
    var i: int = 0
    while i < s.size():
        var c: char = s[i]
        // ASCII: 'a' = 97, 'z' = 122, 'A' = 65, 'Z' = 90
        if c >= 97 and c <= 122:
            result = result + char(c - 32)  // Convert to uppercase
        else:
            result = result + c
        i = i + 1
    return result

// Converts a string to lowercase (ASCII only)
fn to_lower(s: string) -> string:
    var result: string = ""
    var i: int = 0
    while i < s.size():
        var c: char = s[i]
        // ASCII: 'A' = 65, 'Z' = 90, 'a' = 97, 'z' = 122
        if c >= 65 and c <= 90:
            result = result + char(c + 32)  // Convert to lowercase
        else:
            result = result + c
        i = i + 1
    return result

// ── Splitting ─────────────────────────────────────────────────────────────

// Splits a string by a delimiter and returns the parts
// Note: Returns fixed-size array based on max parts
fn str_split(s: string, delimiter: string) -> string[]:
    var parts: string[] = []  // Fixed-size approximation
    var part_count: int = 1
    var i: int = 0
    
    // Count first how many parts
    while i < s.size():
        if i < s.size() - delimiter.size():
            if s[i] == delimiter[0]:
                // Check full delimiter
                var match: bool = true
                var k: int = 1
                while k < delimiter.size():
                    if s[i + k] != delimiter[k]:
                        match = false
                        break
                    k = k + 1
                if match:
                    part_count = part_count + 1
                    i = i + delimiter.size()
                    continue
        i = i + 1
    
    // Allocate and fill
    var result: string[] = []  // Placeholder - fixed size
    // For simplicity, return count and use out parameter approach
    return result  // Full implementation would use dynamic arrays

// ── Prefix/Suffix ─────────────────────────────────────────────────────────

// Checks if a string starts with a prefix
fn str_starts_with(s: string, prefix: string) -> bool:
    if prefix.size() > s.size():
        return false
    var i: int = 0
    while i < prefix.size():
        if s[i] != prefix[i]:
            return false
        i = i + 1
    return true

// Checks if a string ends with a suffix
fn str_ends_with(s: string, suffix: string) -> bool:
    if suffix.size() > s.size():
        return false
    var i: int = 0
    var si: int = s.size() - suffix.size()
    while i < suffix.size():
        if s[si + i] != suffix[i]:
            return false
        i = i + 1
    return true

// ── Escape/Unescape ───────────────────────────────────────────────────────

// Simple HTML escape (converts <, >, &, " to HTML entities)
fn html_escape(s: string) -> string:
    var result: string = ""
    var i: int = 0
    while i < s.size():
        var c: char = s[i]
        if c == '<':
            result = result + "<"
        else if c == '>':
            result = result + ">"
        else if c == '&':
            result = result + "&"
        else if c == '"':
            result = result + """
        else:
            result = result + c
        i = i + 1
    return result

// Simple HTML unescape
fn html_unescape(s: string) -> string:
    var result: string = ""
    var i: int = 0
    while i < s.size():
        var two_char: string = s[i:i+2]  // Simplified substring
        if two_char == "&lt":
            result = result + "<"
            i = i + 3  // Skip <
        else if two_char == "&gt":
            result = result + ">"
            i = i + 3
        else if two_char == "&amp":
            result = result + "&"
            i = i + 4
        else if two_char == "&quot":
            result = result + "\""
            i = i + 5
        else:
            result = result + s[i]
            i = i + 1
    return result

// ── Export for inclusion ─────────────────────────────────────────────────
//
// To include these functions, the host compiler/runtime should export:
// - str_len: string -> int
// - str_concat: string, string -> string
// - str_contains: string, string -> bool
// - to_upper: string -> string
// - to_lower: string -> string
// - str_split: string, string -> string[] (dynamic array)
// - str_starts_with: string, string -> bool
// - str_ends_with: string, string -> bool
// - html_escape: string -> string
// - html_unescape: string -> string