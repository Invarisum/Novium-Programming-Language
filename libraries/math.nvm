// ============================================================================
// math.nvm — Novium Standard Library: Mathematics
// ============================================================================
//
// Provides basic mathematical functions and constants.
//
// Usage:
//   # Include at runtime or compile-time
//   use "math.nvm"
//
// Examples:
//
//   let pi_approx: float = PI
//   let area: float = circle_area(radius)
//   let abs_val: int = abs(-42)
//
// ============================================================================

// ── Mathematical Constants ──────────────────────────────────────────────────

// Pi (π) ≈ 3.14159
let PI: float = 3.141592653589793

// E (Euler's number) ≈ 2.71828
let E: float = 2.718281828459045

// ── Basic Arithmetic ──────────────────────────────────────────────────────

// Absolute value: returns x if x >= 0, otherwise -x
fn abs(x: int) -> int:
    if x < 0:
        return -x
    return x

// Signum: returns -1 if x < 0, 0 if x == 0, 1 if x > 0
fn signum(x: int) -> int:
    if x < 0:
        return -1
    if x > 0:
        return 1
    return 0

// Clamp: restricts a value to a given range
// Returns min if val < min, max if val > max, val otherwise
fn clamp(val: int, min_val: int, max_val: int) -> int:
    if val < min_val:
        return min_val
    if val > max_val:
        return max_val
    return val

// Lerp: linear interpolation between a and b by t (0.0 to 1.0)
// Returns a when t=0, b when t=1, and intermediate values otherwise
fn lerp(a: float, b: float, t: float) -> float:
    return a + (b - a) * t

// ── Power and Roots ──────────────────────────────────────────────────────

// Square root (approximation using Babylonian method)
fn sqrt(x: float) -> float:
    if x <= 0:
        return 0
    // Initial guess
    var guess: float = x / 2.0
    // Iterate 5 times for convergence
    var i: int = 0
    while i < 5:
        guess = (guess + x / guess) / 2.0
        i = i + 1
    return guess

// Power: raises base to exponent
// Supports integer and float exponents
fn pow(base: float, exp: int) -> float:
    var result: float = 1.0
    var i: int = 0
    while i < exp:
        result = result * base
        i = i + 1
    return result

// Cube root approximation
fn cbrt(x: float) -> float:
    if x == 0:
        return 0
    var sign: int = 1
    if x < 0:
        sign = -1
        x = -x
    var guess: float = x / 3.0
    var i: int = 0
    while i < 5:
        guess = (2.0 * guess + x / (guess * guess)) / 3.0
        i = i + 1
    return guess * float(sign)

// ── Trigonometry (basic) ─────────────────────────────────────────────────

// Degrees to radians
fn deg_to_rad(degrees: float) -> float:
    return degrees * (PI / 180.0)

// Radians to degrees
fn rad_to_deg(radians: float) -> float:
    return radians * (180.0 / PI)

// Sine (Taylor series approximation, accurate for small angles)
fn sin(x: float) -> float:
    var rad: float = deg_to_rad(x)  // Assume input in degrees for now
    // Reduce to [-PI, PI]
    var reduced: float = x
    while reduced > PI:
        reduced = reduced - 2.0 * PI
    while reduced < -PI:
        reduced = reduced + 2.0 * PI
    // Taylor series: sin(x) = x - x^3/3! + x^5/5! - x^7/7! + ...
    var term: float = reduced
    var result: float = reduced
    var sign: float = -1.0
    var factorial: float = 3.0
    var power: float = reduced * reduced * reduced
    var i: int = 1
    while i < 5:  // 5 terms for reasonable accuracy
        term = power / factorial
        result = result + sign * term
        power = power * reduced * reduced
        factorial = factorial * (2.0 * float(i) + 1.0) * (2.0 * float(i) + 2.0)
        sign = -sign
        i = i + 1
    return result

// Cosine (using sin(x + PI/2))
fn cos(x: float) -> float:
    return sin(x + 90.0)

// Tangent (sin/cos)
fn tan(x: float) -> float:
    var cos_val: float = cos(x)
    if cos_val == 0:
        return float("inf")  // Represent as very large number
    return sin(x) / cos_val

// ── Hyperbolic Functions ──────────────────────────────────────────────────

fn sinh(x: float) -> float:
    return (exp(x) - exp(-x)) / 2.0

fn cosh(x: float) -> float:
    return (exp(x) + exp(-x)) / 2.0

fn tanh(x: float) -> float:
    var ex: float = exp(x)
    var ex_neg: float = exp(-x)
    return (ex - ex_neg) / (ex + ex_neg)

// ── Export for inclusion ─────────────────────────────────────────────────
//
// To include these functions, the host compiler/runtime should export:
// - Constants: PI, E
// - Functions: abs, signum, clamp, lerp, sqrt, pow, cbrt
// - Conversion: deg_to_rad, rad_to_deg
// - Trig: sin, cos, tan
// - Hyperbolic: sinh, cosh, tanh