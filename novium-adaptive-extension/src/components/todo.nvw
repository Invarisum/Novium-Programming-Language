/**
 * todo.nvw — Novium Web Todo Application (JavaScript/React-style)
 * Full-featured todo app with React-like patterns and performance optimizations.
 */

// ── Core imports ────────────────────────────────────────────────────────────
from fibonacci import fibonacci
from core import safe_divide
from interpreter import greet, main

// ── JavaScript State Types ────────────────────────────────────────────────
type Todo = {
  id: int
  text: string
  completed: boolean
}

type State = {
  todos: list[Todo]
  filter: "all" | "active" | "completed"
  editing_id: int | null
}

// ── Initial State ───────────────────────────────────────────────────────────
const initial_state: State = {
  todos: [
    { id: 1, text: "Learn Novium syntax", completed: false },
    { id: 2, text: "Build a compiler", completed: false },
    { id: 3, text: "Deploy to Wasm", completed: false }
  ],
  filter: "all",
  editing_id: null
}

// ── JavaScript Utility Functions ────────────────────────────────────────────
const uuid4 = (): int => {
  // Simple UUID v4 generator (mock)
  return Math.floor(Math.random() * 1000000)
}

const toggle_todo = (state: State, id: int): State => {
  return {
    ...state,
    todos: state.todos.map((todo: Todo) =>
      todo.id === id ? { ...todo, completed: !todo.completed } : todo
    )
  }
}

const delete_todo = (state: State, id: int): State => {
  return {
    ...state,
    todos: state.todos.filter((todo: Todo) => todo.id !== id)
  }
}

const add_todo = (state: State, text: string): State => {
  if (!text.trim()) return state
  return {
    ...state,
    todos: [
      ...state.todos,
      { id: uuid4(), text: text, completed: false }
    ],
    editing_id: null
  }
}

const set_filter = (state: State, filter: "all" | "active" | "completed"): State => {
  return { ...state, filter }
}

// ── JavaScript Computed Properties (React-style derived state) ─────────────
const get_visible_todos = (state: State): list[Todo] => {
  if (state.filter === "all") return state.todos
  if (state.filter === "active") return state.todos.filter((t: Todo) => !t.completed)
  return state.todos.filter((t: Todo) => t.completed)
}

const get_remaining_count = (state: State): int => {
  return state.todos.filter((t: Todo) => !t.completed).length
}

const get_completed_count = (state: State): int => {
  return state.todos.filter((t: Todo) => t.completed).length
}

// ── Todo Component (React function component style) ────────────────────────
const TodoItem = (todo: Todo, on_toggle: (id: int) => void, on_delete: (id: int) => void): dict => {
  return {
    type: "div",
    props: {
      class: todo.completed ? "completed" : "",
      children: [
        { type: "div", props: { class: "view" }, children: [
          { type: "input", props: {
            type: "checkbox",
            checked: todo.completed,
            onchange: () => on_toggle(todo.id)
          } },
          { type: "label", props: { children: todo.text } },
          { type: "button", props: {
            onClick: () => on_delete(todo.id)
          }, children: "×" }
        ]},
        { type: "footer", props: { class: "edit" }, children: [
          { type: "input", props: {
            class: "edit-input",
            value: todo.text,
            onDoubleClick: () => /* start editing */ null
          } }
        ]}
      ]
    }
  }
}

// ── Todo Footer Component ──────────────────────────────────────────────────
const TodoFooter = (state: State): dict => {
  const remaining: int = get_remaining_count(state)
  const completed: int = get_completed_count(state)

  return {
    type: "footer",
    props: {
      children: [
        { type: "span", props: { class: "todo-count" }, children: [
          { type: "strong", props: { children: remaining } },
          remaining !== 1 ? { type: "span", props: { children: " items left" } } : null
        ]},
        { type: "ul", props: { class: "filters" }, children: [
          { type: "li", props: { class: state.filter === "all" ? "selected" : "" }, children: [
            { type: "a", props: { href: "#/", onClick: (e: Event) => { e.preventDefault(); set_filter(state, "all") } }, "All" ]
          ]},
          { type: "li", props: { class: state.filter === "active" ? "selected" : "" }, children: [
            { type: "a", props: { href: "#/active", onClick: (e: Event) => { e.preventDefault(); set_filter(state, "active") } }, "Active" ]
          ]},
          { type: "li", props: { class: state.filter === "completed" ? "selected" : "" }, children: [
            { type: "a", props: { href: "#/completed", onClick: (e: Event) => { e.preventDefault(); set_filter(state, "completed") } }, "Completed" ]
          ]}
        ]}
      ]
    }
  }
}

// ── Todo Header Component ──────────────────────────────────────────────────
const TodoHeader = (on_add: (text: string) => void): dict => {
  return {
    type: "header",
    props: {
      children: [
        { type: "h1", props: { children: "Novium Todo App" } },
        { type: "input", props: {
          class: "new-todo",
          placeholder: "What needs to be done?",
          onKeyDown: (e: Event) => {
            if ((e as any).key === "Enter") {
              const input: HTMLInputElement = e.target as HTMLInputElement
              on_add(input.value)
              input.value = ""
            }
          }
        } }
      ]
    }
  }
}

// ── App Component ───────────────────────────────────────────────────────────
const TodoApp = (state: State, on_toggle: (id: int) => void, on_delete: (id: int) => void, on_add: (text: string) => void): dict => {
  const visible_todos: list[Todo] = get_visible_todos(state)

  return {
    type: "div",
    props: {
      class: "todoapp",
      children: [
        { type: "TodoHeader", props: { on_add: on_add } },
        { type: "section", props: { class: "main" }, children: [
          { type: "TodoFooter", props: { state: state } },
          { type: "ul", props: { class: "todo-list" }, children: [
            ...visible_todos.map((todo: Todo) =>
              { type: "TodoItem", props: {
                todo: todo,
                on_toggle: (id: int) => on_toggle(id),
                on_delete: (id: int) => on_delete(id)
              } }
            )
          ]}
        ]},
        { type: "footer", props: { class: "footer" }, children: [
          { type: "span", props: { class: "remaining" }, children: [
            { type: "strong", props: { children: get_remaining_count(state) } },
            " remaining"
          ]}
        ]}
      ]
    }
  }
}

// ── Exports for Wasm/JS compilation ────────────────────────────────────────
export {
  // State type and initial state
  State, initial_state,

  // Utility functions
  uuid4, toggle_todo, delete_todo, add_todo, set_filter,

  // Computed properties
  get_visible_todos, get_remaining_count, get_completed_count,

  // Components
  TodoItem, TodoFooter, TodoHeader, TodoApp,

  // App entry point
  main
}