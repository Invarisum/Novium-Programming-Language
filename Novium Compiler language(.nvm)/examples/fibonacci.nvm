# fibonacci.nvm — iterative, allocation-light Novium v0.1 example

fn fibonacci(n: int) -> int:
    if n <= 1:
        return n

    let mut previous: int = 0
    let mut current: int = 1
    let mut index: int = 2

    while index <= n:
        let next: int = previous + current
        previous = current
        current = next
        index += 1

    return current

fn main() -> void:
    print(fibonacci(10))
