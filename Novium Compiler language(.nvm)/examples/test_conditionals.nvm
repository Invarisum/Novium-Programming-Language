// test_conditionals.nvm — Conditional test program
fn max(a int, b int) int:
    if a > b:
        return a
    return b

fn main() -> void:
    let x: int = 10
    let y: int = 20
    let m: int = max(x, y)
    print(m)
    
    if m > 15:
        print("max is greater than 15")
    elif m > 10:
        print("max is greater than 10")
    else:
        print("max is 10 or less")